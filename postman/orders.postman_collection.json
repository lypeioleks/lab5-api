  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login status is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"token\",\r",
              "    pm.response.json().accessToken\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"alice@example.com\",\r\n  \"password\": \"Secret123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Order created\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"orderId\",\r",
              "    pm.response.json().id\r",
              ");\r",
              "\r",
              "pm.test(\"Order total is correct\", () => {\r",
              "    pm.expect(pm.response.json().total).to.eql(1700);\r",
              "});\r",
              "\r",
              "pm.test(\"Location header exists\", () => {\r",
              "    pm.expect(pm.response.headers.get(\"Location\"))\r",
              "        .to.eql(`/orders/${pm.response.json().id}`);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"items\": [\r\n    {\r\n      \"name\": \"Laptop\",\r\n      \"price\": 1000,\r\n      \"qty\": 2\r\n    }\r\n  ]\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Filter orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Filter returns 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Order total matches filter\", () => {\r",
              "    const orders = pm.response.json();\r",
              "    pm.expect(\r",
              "        orders.some(order => order.total === 1700)\r",
              "    ).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/orders?minTotal=1700&maxTotal=1700",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "orders"
          ],
          "query": [
            {
              "key": "minTotal",
              "value": "1700"
            },
            {
              "key": "maxTotal",
              "value": "1700"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ]
